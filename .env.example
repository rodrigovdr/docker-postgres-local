# PostgreSQL Database Configuration
DB_IMAGE_TAG=17-alpine
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=myapp
DB_PORT=5432

# PostgREST API Configuration
API_IMAGE_TAG=v14.3
PGRST_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_MASTER_KEY=your-api-master-key-change-this

# PgAdmin Configuration
PGADMIN_IMAGE_TAG=latest
PGADMIN_MAIL=admin@example.com
PGADMIN_PW=admin
# PGADMIN_PORT=5050  # Uncomment if you want direct access (not recommended with Nginx)

# PostgREST API Port (optional, if not using Nginx proxy)
# API_PORT=3000

# Swagger UI Port (optional, if not using Nginx proxy)
# SWAGGER_PORT=8080

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM (cron format)
BACKUP_KEEP_DAYS=30        # Keep backups for 30 days
